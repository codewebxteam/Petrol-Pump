{
  "expo": {
    "name": "IOCL-Pump-Management",
    "slug": "baijnathsoftware",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/pump-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pump-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.baijnathsoftwaresteam.baijnathsoftware"
    },
    "web": {
      "favicon": "./assets/pump-logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/pump-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7a887737-075b-48cc-ad4f-b8eff6396a8d"
      }
    }
  }
}
