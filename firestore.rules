rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write for petrol pump daily staff operations without requiring admin login:
    // Daily entry, meter readings, stock, udhari, salary advances, sample labels
    match /sales_reports/{document=**} {
      allow read, write: if true;
    }

    match /nozzles/{document=**} {
      allow read, write: if true;
    }

    match /machines/{document=**} {
      allow read, write: if true;
    }

    match /tanks/{document=**} {
      allow read, write: if true;
    }

    match /tank_logs/{document=**} {
      allow read, write: if true;
    }

    match /udhari_records/{document=**} {
      allow read, write: if true;
    }

    match /edit_requests/{document=**} {
      allow read, write: if true;
    }

    match /staff_salary_advances/{document=**} {
      allow read, write: if true;
    }

    match /sample_labels/{document=**} {
      allow read, write: if true;
    }

    match /shifts/{document=**} {
      allow read, write: if true;
    }

    // Allow anyone to read staff/user list for dropdowns; only logged-in admin can write/modify users
    match /users/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Protected Admin-only collections (bank deposits, settings, audit)
    match /bank_deposits/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Fallback: require admin login for any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

