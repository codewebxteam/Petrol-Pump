rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write for petrol pump daily operations
    // (nozzles, salesmen list, tanks, and daily sales reports)
    match /nozzles/{document=**} {
      allow read, write: if true;
    }

    match /machines/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tanks/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sales_reports/{document=**} {
      allow read, write: if true;
    }

    match /tank_logs/{document=**} {
      allow read, write: if true;
    }

    match /udhari_records/{document=**} {
      allow read, write: if true;
    }

    match /edit_requests/{document=**} {
      allow read, write: if true;
    }

    match /staff_salary_advances/{document=**} {
      allow read, write: if true;
    }

    // All other collections require login
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
